# SHADOW-INTEL backend environment configuration.
# Copy to .env and adjust for local development. Never commit the real .env file.

ENVIRONMENT=development

# Security.
# Leave blank for local development: an ephemeral key is generated per process.
# Required (non-empty) when ENVIRONMENT=production, where startup fails without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Storage
DATA_DIR=data

# Neo4j (local, open-source community edition only — no managed cloud instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Flight Recorder event store (local SQLite)
EVENT_STORE_PATH=data/event_store.db

# Local identity store: user accounts, roles and sessions (local SQLite)
IDENTITY_DB_PATH=data/identity.db
SESSION_TTL_MINUTES=60

# Password for the synthetic development accounts created by:
#   python -m app.security.identity.seed
# Set this locally only; seeding refuses to run when it is empty.
DEV_SEED_PASSWORD=

# JWT placeholder (authentication not yet implemented)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Clearance policy
CLEARANCE_POLICY_PATH=security/policy/clearance_policy.json

# Logging
LOG_LEVEL=INFO

# Enabled agency plugins (JSON list)
ENABLED_PLUGINS=["police","cybercrime","financial_crime"]
