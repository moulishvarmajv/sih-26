# SHADOW-INTEL backend environment configuration.
#
# Copy to backend/.env and adjust for local development. Never commit the real
# .env file.
#
# Unknown keys are rejected at startup, so this file may contain only settings
# defined in app/core/config.py. A test loads this file and asserts it still
# produces valid settings, so it cannot drift from the code again.
#
# Every value below is already the default. Copying the file unchanged and
# running the application is a no-op — set only what you actually need to
# override.

ENVIRONMENT=development

# Security.
# Leave blank for local development: an ephemeral key is generated per process.
# Required (non-empty) when ENVIRONMENT=production, where startup fails without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Browser origins allowed to call the API, as a JSON list. Never "*": wildcard
# origins on credentialed requests would expose session tokens to any site.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Knowledge graph (local, open-source community edition only — no managed cloud
# instance). `docker compose up -d neo4j` serves bolt on 7687 and the browser on
# 7474. Change the password here and in the compose environment together.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shadowintel
NEO4J_DATABASE=neo4j

# Flight Recorder event store (local SQLite)
EVENT_STORE_PATH=data/event_store.db

# Local identity store: user accounts, roles and sessions (local SQLite)
IDENTITY_DB_PATH=data/identity.db
SESSION_TTL_MINUTES=60

# Investigation state: cases, evidence metadata and entity-resolution decisions.
# Raw evidence payloads live outside the database, under the object root.
INVESTIGATION_DB_PATH=data/investigation.db
EVIDENCE_OBJECT_ROOT=data/evidence_objects

# Policy documents. Relative paths are resolved against the backend directory.
CLEARANCE_POLICY_PATH=app/security/policy/clearance_policy.json
RESOLUTION_POLICY_PATH=app/core/resolution/resolution_policy.json
ANALYTICS_POLICY_PATH=app/core/analytics/analytics_policy.json

# Logging
LOG_LEVEL=INFO

# NOT a .env key. The development seeder reads DEV_SEED_PASSWORD from the
# process environment only, so that a password for the synthetic accounts never
# has to sit in a file. Putting it here would be rejected at startup. Run:
#
#   DEV_SEED_PASSWORD='choose-a-local-password' python -m app.security.identity.seed
